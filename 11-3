#include <stdio.h> // Подключаем библиотеку для вывода текста на экран (printf)

int main() {
    // ========================================================
    // ПУНКТ 1: Тип данных double
    // ========================================================
    double x1 = 5.5;      // 1. Создаем обычную переменную и кладем в нее число
    double *pa1 = &x1;    // 2. Создаем указатель и записываем в него адрес переменной x1 через &

    printf("--- 1. Тип double ---\n");
    printf("Изначальный адрес: %p, значение: %g\n", pa1, *pa1);

    pa1++; // Шагаем вперед (инкремент)
    printf("После pa1++: %p (адрес увеличился на 8 байт)\n", pa1);

    pa1--; // Шагаем обратно (декремент)
    printf("После pa1--: %p, значение вернулось: %g\n\n", pa1, *pa1);


    // ========================================================
    // ПУНКТ 2: Тип данных char
    // ========================================================
    char x2 = 'A';        // 1. Создаем символьную переменную
    char *pa2 = &x2;      // 2. Инициализируем указатель адресом переменной x2 через &

    printf("--- 2. Тип char ---\n");
    printf("Изначальный адрес: %p, символ: %c\n", pa2, *pa2);

    pa2++; // Шагаем вперед
    printf("После pa2++: %p (адрес увеличился всего на 1 байт)\n", pa2);

    pa2--; // Шагаем обратно
    printf("После pa2--: %p, символ вернулся: %c\n\n", pa2, *pa2);


    // ========================================================
    // ПУНКТ 3: Типы long double, short unsigned int и _Bool
    // ========================================================
    
    // а) Тип long double
    long double x3 = 12.34;
    long double *pa3 = &x3; // Привязываем указатель к переменной через &
    printf("--- 3а. Тип long double ---\n");
    printf("Было:  %p\n", pa3);
    pa3++;
    printf("Стало: %p (сдвиг на 16 байт или 8 байт, зависит от системы)\n\n", pa3);

    // б) Тип short unsigned int
    short unsigned int x4 = 10;
    short unsigned int *pa4 = &x4; // Привязываем указатель к переменной через &
    printf("--- 3б. Тип short unsigned int ---\n");
    printf("Было:  %p\n", pa4);
    pa4++;
    printf("Стало: %p (сдвиг на 2 байта)\n\n", pa4);

    // в) Тип _Bool
    _Bool x5 = 1;
    _Bool *pa5 = &x5; // Привязываем указатель к переменной через &
    printf("--- 3в. Тип _Bool ---\n");
    printf("Было:  %p\n", pa5);
    pa5++;
    printf("Стало: %p (сдвиг на 1 байт)\n", pa5);

    return 0; // Завершаем программу
}
