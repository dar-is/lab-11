#include <stdio.h> // Подключаем библиотеку для вывода на экран (printf)

int main() {
    // Объявляем и инициализируем массив на 10 элементов типа float[span_0](start_span)[span_0](end_span)
    float array[10] = {1.1f, 2.2f, 3.3f, 4.4f, 5.5f, 6.6f, 7.7f, 8.8f, 9.9f, 10.0f};
    
    // Объявляем указатель для работы с массивом[span_1](start_span)[span_1](end_span)
    float *ptr_a;

    // ==========================================================
    // 4.1 Проверяем, что имя массива — это его адрес
    // ==========================================================
    printf("--- ПУНКТ 4.1 ---\n");
    printf("Адрес через имя массива (array):    %p\n", (void*)array);
    printf("Адрес через нулевой элемент (&array[0]): %p\n", (void*)&array[0]);
    printf("Адрес всего массива целиком (&array):    %p\n\n", (void*)&array);
    // Вывод: все три адреса будут абсолютно одинаковыми!


    // ==========================================================
    // 4.2 Устанавливаем указатель на начало и двигаем его
    // ==========================================================
    printf("--- ПУНКТ 4.2 ---\n");
    ptr_a = array; // Указываем на первый элемент массива

    // Сдвиг на 1 элемент вперед (ptr_a++)
    ptr_a++;
    printf("После ptr_a++ -> адрес: %p, значение: %g\n", (void*)ptr_a, *ptr_a);

    // Сдвиг на 4 элемента вперед (ptr_a + 4)
    // (тут мы временно прибавляем 4, сам указатель не перезаписываем)
    printf("После ptr_a+4 -> адрес: %p, значение: %g\n", (void*)(ptr_a + 4), *(ptr_a + 4));

    // Сдвиг на 2 элемента назад (ptr_a - 2)
    printf("После ptr_a-2 -> адрес: %p, значение: %g\n\n", (void*)(ptr_a - 2), *(ptr_a - 2));


    // ==========================================================
    // 4.3 Обход массива в прямом порядке с шагом 2
    // ==========================================================
    printf("--- ПУНКТ 4.3 (Прямой обход с шагом 2) ---\n");
    ptr_a = array; // Возвращаем в начало массива

    for (int i = 0; i < 10; i += 2) {
        printf("Элемент с индексом %d: значение = %g (адрес: %p)\n", i, *ptr_a, (void*)ptr_a);
        ptr_a += 2; // Передвигаем указатель сразу на 2 элемента вперед
    }
    printf("\n");


    // ==========================================================
    // 4.4 Обход массива в обратном порядке (от конца к началу)
    // ==========================================================
    printf("--- ПУНКТ 4.4 (Обратный обход) ---\n");
    
    // Устанавливаем указатель на САМЫЙ ПОСЛЕДНИЙ элемент массива (индекс 9)
    ptr_a = &array[9]; 

    for (int i = 9; i >= 0; i--) {
        printf("Элемент %d: значение = %g (адрес: %p)\n", i, *ptr_a, (void*)ptr_a);
        ptr_a--; // Сдвигаем указатель назад на один элемент
    }

    return 0; // Успешное завершение программы
}
