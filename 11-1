#include <stdio.h> // Подключаем библиотеку, чтобы работала команда printf (вывод на экран)

int main() {
    // 1. Создаем обычные переменные разных типов (просто чтобы было на что указывать)
    char a = 'A';
    int b = 10;
    double c = 3.14;

    // 2. Создаем указатели на эти переменные (звездочка * означает, что это указатель)
    char *p_char = &a;     // указатель на char
    int *p_int = &b;       // указатель на int
    double *p_double = &c; // указатель на double

    // 3. Узнаем размер памяти под каждый указатель с помощью sizeof() и выводим на экран
    // %zu — специальный формат для вывода размера памяти (можно также использовать %lu)
    printf("Размер указателя на char: %zu байт\n", sizeof(p_char));
    printf("Размер указателя на int: %zu байт\n", sizeof(p_int));
    printf("Размер указателя на double: %zu байт\n", sizeof(p_double));

    return 0; // Успешное завершение программы
}
