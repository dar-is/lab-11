#include <stdio.h> // Подключаем библиотеку для вывода текста на экран (printf)

// =========================================================================
// ПУНКТ 2: Универсальная функция для побайтового вывода переменной ЛЮБОГО типа
// =========================================================================
// void* ptr — специальный «всеядный» указатель, который примет адрес любой переменной
// int size  — размер этой переменной в байтах (узнаем через sizeof)
void print_bytes(void *ptr, int size) {
    // Превращаем «всеядный» указатель в указатель на 1 байт (unsigned char*),
    // чтобы можно было шагать по памяти ровно по 1 байту за раз
    unsigned char *byte_ptr = (unsigned char *)ptr;

    printf("Байты в памяти (от младшего адреса к старшему): ");
    for (int i = 0; i < size; i++) {
        // %.2X выводит байт в красивом 16-ричном виде из двух символов (например, 78 или 0A)
        printf("%.2X ", byte_ptr[i]);
    }
    printf("\n\n");
}

