#include <stdio.h> // Подключаем библиотеку для вывода текста на экран (printf)

int main() {
    // Создаем массив всего из двух элементов типа int
    // В памяти компьютера они будут лежать строго друг за другом
    int arr[2];

    // Берем указатели на первый и второй элементы этого массива
    int *p1 = &arr[0]; // Указатель на первый элемент
    int *p2 = &arr[1]; // Указатель на второй элемент

    // Хитрость: приводим указатели к типу (char*). 
    // Так как тип char всегда весит ровно 1 байт, разница между адресами 
    // покажет нам точное количество байт, которое занимает один int.
    long size_int = (char*)p2 - (char*)p1;

    // Выводим результат на экран
    printf("Размер типа int без использования sizeof: %ld байт\n", size_int);

    return 0; // Успешное завершение программы
}
