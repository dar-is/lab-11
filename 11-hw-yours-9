#include <stdio.h> // Подключаем библиотеку для вывода текста на экран (printf)

int main() {
    // Создаем массив из двух элементов типа float
    // Они будут лежать в памяти компьютера друг за другом
    float arr[2];

    // Берем указатели на первый и второй элементы массива
    float *p1 = &arr[0]; // Указывает на первый элемент
    float *p2 = &arr[1]; // Указывает на второй элемент

    // Хитрость: приводим указатели к (char*). 
    // Так как один char весит ровно 1 байт, вычитание адресов покажет 
    // точный размер типа float в байтах.
    long size_float = (char*)p2 - (char*)p1;

    // Выводим результат на экран
    printf("Размер типа float без использования sizeof: %ld байт\n", size_float);

    return 0; // Успешное завершение программы
}
