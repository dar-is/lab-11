#include <stdio.h> // Подключаем библиотеку для ввода-вывода (чтобы работал printf)

int main() {
    // Создаем переменную PI с дробным числом и два указателя на тип float
    float PI = 3.14159, *p1, *p2;

    // Присваиваем указателям адрес переменной PI
    // Сначала p2 получает адрес (&PI), а потом этот же адрес передается в p1
    p1 = p2 = &PI;

    // Выводим информацию для первого указателя (p1)
    // %p показывает сам адрес памяти, а %g выводит число по этому адресу (значение PI)
    printf("По адресу p1=%p хранится *p1=%g\n", p1, *p1);

    // Выводим точно такую же информацию для второго указателя (p2)
    printf("По адресу p2=%p хранится *p2=%g\n", p2, *p2);

    return 0; // Конец программы
}
